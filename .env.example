# Superuser (or a role allowed to create roles and databases) on your local PostgreSQL 16
PG_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Database the app uses
DB_NAME=superfix
# Password given to the least-privileged application role superfix_app
APP_DB_PASSWORD=superfix_app_local
# Force the secure cookie flag (it is set automatically when a proxy reports https); keep false on http://localhost
COOKIE_SECURE=false
# Show the demo user names and password on the sign-in page (local demo only; never set this on UAT or production)
SHOW_DEMO_USERS=true
