{
  "name": "superfix-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:deploy": "tsx scripts/db-setup.ts && tsx scripts/migrate.ts && tsx scripts/seed.ts --if-empty"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
