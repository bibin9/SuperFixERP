{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build"
  },
  "deploy": {
    "preDeployCommand": "npm run db:deploy",
    "startCommand": "npm start",
    "healthcheckPath": "/login",
    "restartPolicyType": "ON_FAILURE"
  }
}
